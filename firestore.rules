rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Reusable Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Specific Validation Helpers ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'createdAt'])
        && data.keys().size() == 4
        && data.uid is string
        && data.uid == request.auth.uid
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 150
        && data.createdAt is string;
    }

    function isValidReservation(data) {
      return data.keys().hasAll(['ref', 'userId', 'outlet', 'table', 'date', 'time', 'guests', 'bookedAt', 'status'])
        && data.keys().size() == 9
        && data.ref is string
        && data.ref.matches('^RES-[0-9]{6}$')
        && data.userId is string
        && data.userId == request.auth.uid
        && data.outlet is string
        && data.outlet.size() >= 2
        && data.outlet.size() <= 150
        && data.table is string
        && data.table.size() >= 1
        && data.table.size() <= 10
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && data.guests is string
        && data.guests.size() <= 50
        && data.bookedAt is string
        && data.status is string
        && data.status in ['Confirmed', 'Cancelled'];
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'date', 'items', 'total', 'status'])
        && data.keys().size() == 6
        && data.id is string
        && data.id.matches('^AR-[0-9]{6}$')
        && data.userId is string
        && data.userId == request.auth.uid
        && data.date is string
        && data.items is list
        && data.items.size() <= 50
        && data.total is number
        && data.total >= 0
        && data.status is string
        && data.status in ['Preparing', 'On The Way', 'Delivered', 'Cancelled'];
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'submittedAt'])
        && data.keys().size() == 5
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 150
        && data.subject is string
        && data.subject.size() >= 3
        && data.subject.size() <= 200
        && data.message is string
        && data.message.size() >= 10
        && data.message.size() <= 2000
        && data.submittedAt is string;
    }

    // --- Collection Matches ---

    // 1. Users profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId);
      allow create: if isSignedIn() && (request.auth.uid == userId) && isValidUserProfile(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId) && isValidUserProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email']);
    }

    // 2. Reservations
    match /reservations/{reservationId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid);
      allow create: if isEmailVerified() && isValidId(reservationId) && isValidReservation(incoming());
      allow update: if isEmailVerified() && isValidId(reservationId) && (existing().userId == request.auth.uid)
        && isValidReservation(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    // 3. Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid);
      allow create: if isEmailVerified() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if isEmailVerified() && isValidId(orderId) && (existing().userId == request.auth.uid)
        && isValidOrder(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    // 4. Contact Inquiries
    match /contact_inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      // No general reads/updates allowed for public inquiries
    }
  }
}
